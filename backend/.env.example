# Copy this file to .env and fill in real values. Never commit .env to git.

# Django
SECRET_KEY=<generate with: python -c "import secrets; print(secrets.token_urlsafe(50))">
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=siem_db
DB_USER=<db_user>
DB_PASSWORD=<strong_password>
DB_HOST=localhost
DB_PORT=5432

# JWT token lifetimes (seconds)
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=86400

# Default admin account (set before first run, then rotate the password)
DEFAULT_ADMIN_EMAIL=admin@yourdomain.com
DEFAULT_ADMIN_PASSWORD=<strong_password>
DEFAULT_ADMIN_NAME=SIEM Admin

# Production only
# FRONTEND_URL=https://your-frontend.com
# RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com
